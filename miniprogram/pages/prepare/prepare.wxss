.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.topic-name {
  font-size: 52rpx;
  font-weight: 800;
  margin-bottom: 56rpx;
}

.ready-tip {
  color: var(--muted);
  font-size: 34rpx;
  line-height: 2;
  display: flex;
  flex-direction: column;
}

.green { color: var(--neon-green); font-weight: 700; }
.pink { color: var(--neon-pink); font-weight: 700; }

.btn-ghost {
  margin-bottom: 44rpx;
}
