.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.home-left {
  padding: 80rpx 0 40rpx;
  text-align: center;
}

.home-tagline {
  color: var(--neon-cyan);
  font-size: 28rpx;
  letter-spacing: 8rpx;
  margin-top: 24rpx;
  text-shadow: 0 0 16rpx var(--neon-cyan);
}

.home-scroll {
  flex: 1;
  max-height: 62vh;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.topic-card {
  border: 1px solid var(--card-brd);
  background: var(--card);
  border-radius: 32rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.topic-card.selected {
  border-color: var(--neon-cyan);
  background: linear-gradient(160deg, rgba(5, 217, 232, 0.18), rgba(5, 217, 232, 0.04));
  box-shadow: 0 0 36rpx rgba(5, 217, 232, 0.35) inset;
}

.topic-card.selected .topic-name {
  color: var(--neon-cyan);
}

.topic-name {
  font-size: 34rpx;
  font-weight: 700;
}

.topic-count {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.chip {
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  border: 1px solid var(--card-brd);
  background: var(--card);
  font-size: 30rpx;
}

.chip.diff.selected {
  background: var(--neon-green);
  color: #001;
  font-weight: 700;
  border-color: var(--neon-green);
}

.chip.time.selected {
  background: var(--neon-yellow);
  color: #001;
  font-weight: 700;
  border-color: var(--neon-yellow);
}

.slider-wrap {
  margin-top: 32rpx;
  font-size: 28rpx;
}

.slider-val {
  color: var(--neon-yellow);
  font-weight: 800;
}

.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
}

.privacy-box {
  background: var(--bg2);
  border: 1px solid var(--card-brd);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  text-align: center;
}

.privacy-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--muted);
}

.privacy-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.privacy-btns .btn-primary.sm {
  flex: 1;
  margin: 0;
  padding: 24rpx;
  font-size: 30rpx;
}

.privacy-btns .btn-ghost {
  flex: 1;
}

.privacy-text .link {
  color: var(--neon-cyan);
  text-decoration: underline;
}

@media (orientation: landscape) {
  .page {
    flex-direction: row;
    padding: 0;
  }

  .home-left {
    flex: 0 0 38%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border-right: 1px solid var(--card-brd);
    padding: 40rpx;
  }

  .home-scroll {
    flex: 1;
    max-height: none;
    padding: 24rpx 48rpx 0;
  }

  .btn-primary {
    position: absolute;
    bottom: 24rpx;
    left: 42%;
    right: 40rpx;
  }
}
