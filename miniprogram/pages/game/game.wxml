<view class="page">
  <!-- 竖屏旋转提示（倒数 + 答题阶段） -->
  <view class="rotate-tip" wx:if="{{showRotate && (phase === 'playing' || phase === 'countdown')}}">
    <view class="rot-icon">⟳</view>
    <view class="rot-title">请把手机横过来</view>
    <view class="rot-sub">横屏举到额头，屏幕面向队友</view>
  </view>

  <!-- 倒数阶段 -->
  <view class="countdown" wx:if="{{phase === 'countdown'}}">
    <text class="count-num">{{countNum}}</text>
  </view>

  <!-- 游戏阶段 -->
  <block wx:if="{{phase === 'playing'}}">
    <view class="timer-bar-wrap">
      <view class="timer-bar {{urgent ? 'urgent' : ''}}" style="width: {{timerPct}}%;"></view>
    </view>
    <view class="timer-text {{urgent ? 'urgent' : ''}}">{{timeLeft}}</view>
    <view class="score-mini">对 <text class="green">{{scoreCorrect}}</text> · 过 {{scoreSkip}}</view>
    <view class="btn-quit" bindtap="onQuit">✕ 退出</view>

    <view class="flash {{flashType}} {{flashShow ? 'show' : ''}}" wx:if="{{flashShow}}">{{flashText}}</view>

    <view class="word-box">
      <view class="word-main {{wordPop ? 'pop' : ''}}">{{word}}</view>
    </view>
    <view class="word-hint" wx:if="{{noGyro}}">{{wordHint}}</view>

    <view class="game-controls" wx:if="{{noGyro}}">
      <view class="gc-btn gc-skip" bindtap="onSkip">跳过</view>
      <view class="gc-btn gc-correct" bindtap="onCorrect">答对</view>
    </view>
  </block>
</view>
