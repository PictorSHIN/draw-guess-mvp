<view class="page" bindtap="onTapStart">
  <!-- 点击开始 / 校准中 -->
  <view class="tap-start" wx:if="{{phase === 'tap'}}" catchtap="onTapStart">
    <view class="tap-title">{{calibrating ? '保持姿势…' : '点击屏幕开始'}}</view>
    <view class="tap-sub">{{calibrating ? '正在校准体感，请横举额头' : '举到额头，屏幕朝队友'}}</view>
  </view>

  <!-- 游戏阶段 -->
  <block wx:if="{{phase === 'playing'}}">
    <view class="timer-bar-wrap">
      <view class="timer-bar {{urgent ? 'urgent' : ''}}" style="width: {{timerPct}}%;"></view>
    </view>
    <view class="timer-text {{urgent ? 'urgent' : ''}}">{{timeLeft}}</view>
    <view class="score-mini">对 <text class="green">{{scoreCorrect}}</text> · 过 {{scoreSkip}}</view>
    <view class="btn-quit" catchtap="onQuit">✕ 退出</view>

    <view class="flash {{flashType}} {{flashShow ? 'show' : ''}}" wx:if="{{flashShow}}">{{flashText}}</view>

    <view class="word-box">
      <view class="word-main {{wordPop ? 'pop' : ''}}">{{word}}</view>
    </view>
    <view class="word-hint" wx:if="{{noGyro}}">{{wordHint}}</view>

    <view class="game-controls" wx:if="{{noGyro}}">
      <view class="gc-btn gc-skip" catchtap="onSkip">跳过</view>
      <view class="gc-btn gc-correct" catchtap="onCorrect">答对</view>
    </view>
  </block>
</view>
